{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/vllm",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "demo",
      "inherits": "base",
      "environment": {
        "MAX_JOBS": "16",
        "TORCH_CUDA_ARCH_LIST": "8.6",
        "VLLM_FA_CMAKE_GPU_ARCHES": "8.6"
      },
      "cacheVariables": {
        // "FETCHCONTENT_BASE_DIR": "${sourceDir}/_demos/_deps",
        // "FETCHCONTENT_FULLY_DISCONNECTED": false,
        // "FETCHCONTENT_UPDATES_DISCONNECTED": true,
        "VLLM_PYTHON_EXECUTABLE": "/usr/bin/python3",
        "VLLM_CUTLASS_SRC_DIR": "${sourceDir}/3rd/cutlass",
        "FLASH_MLA_SRC_DIR": "${sourceDir}/3rd/FlashMLA",
        "VLLM_FLASH_ATTN_SRC_DIR": "${sourceDir}/3rd/flash-attention",
        "AA": "BB"
      }
    }
  ]
}
